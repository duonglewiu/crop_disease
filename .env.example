# ==========================================
# Cấu hình biến môi trường Crop Disease Edge AI
# ==========================================

# 1. FastAPI Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="Crop Disease RAG Service"

# 2. Vector DB (ChromaDB) Configuration
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=crop_disease_treatments
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# 3. LLM API Key (Dùng cho luồng RAG sinh phác đồ)
# Chọn nhà cung cấp: google_gemini hoặc openai
LLM_PROVIDER=google_gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Hoặc nếu dùng OpenAI:
# OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-1.5-flash

# 4. Electron / React Frontend Settings
VITE_API_BASE_URL=http://localhost:8000/api/v1
SQLITE_DB_PATH=./data/sqlite/disease_treatments.db

