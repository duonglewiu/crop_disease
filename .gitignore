# ==========================================
# Git Ignore for Crop Disease Edge AI Project
# ==========================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv
venv/
ENV/
env/

# Jupyter Notebooks Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Model Weights & Large Checkpoints (>100MB exceeds GitHub push limit)
*.pth
*.pt
*.h5
*.onnx
*.onnx.data
*.bin
*.tar.gz
*.ckpt
ai_core/weights/*
!ai_core/weights/.gitkeep

# Local AI Assistant & Planning Workspace Tools (not needed for build/docker/test)
.agent/
.planning/
design-system/

# Node.js & Electron
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
desktop/dist/
desktop/out/
desktop/release/
*.exe
*.dmg
*.AppImage

# Databases & Vector DB storage
*.sqlite
*.sqlite3
*.db
chroma_data/
server/chroma_db/
data/sqlite/*.db
!data/sqlite/*.sql

# Datasets (Prevent uploading raw GBs of PlantVillage dataset)
data/plantvillage/*
!data/plantvillage/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# IDEs & Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Testing & Coverage
.coverage
.pytest_cache/
htmlcov/

# Logs
logs/
*.log

